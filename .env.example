PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/auctionpro
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


SITE_OTP_EMAIL=hstudy.project@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hstudy.project@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=AuctionPro Security <hstudy.project@gmail.com>

# Site OTP (optional tuning)
# How long a verified browser session lasts, in minutes (default 30)
SITE_OTP_SESSION_MINUTES=30
# Number of reverse proxies in front of the API (Render/Railway = 1). Only used when NODE_ENV=production
TRUST_PROXY=1

